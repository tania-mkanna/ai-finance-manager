# Database
POSTGRES_DB=finance_db
POSTGRES_PASSWORD=
POSTGRES_USER=finance_user
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/finance_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend
API_PORT=8080

# Receipt uploads (bytes)
APP_RECEIPT_MAX_FILE_SIZE_BYTES=5242880
# Set at least 1 MiB (1048576 bytes) above the file limit for multipart fields and headers.
APP_RECEIPT_MAX_REQUEST_SIZE_BYTES=6291456

# AI Service
AI_SERVICE_PORT=8000

# Frontend
WEB_PORT=5173

# JWT
JWT_SECRET=actual_password

# OpenAI / LLM
OPENAI_API_KEY=
